#include <iostream>
#include <vector>
#include <fstream>
#include <string>
using namespace std;

struct Formula {
    int carbs;
    int hydro;
    vector<string> names;
};


void fillVector(vector<Formula>& vec, ifstream& file);
void insertMolecule(vector<Formula>& vec, const string& name, const int& carbs, const int& hydro);
int findFormula(vector<Formula>& vec, const int& carbs, const int& hydro);
void displayVector(const vector<Formula>& vec);
void printFormula(const Formula&);
void sortVector(vector<Formula>& vec);

void openFile(ifstream& file) {
    string filename;
    do {
        cout << "Enter filename: ";
        cin >> filename;
        file.open(filename);
        if (!file) {
            cout << "Unable to open file." << endl;
        }
    } while (!file);

}
void fillVector(vector<Formula>& vec, ifstream& file) {
    string name;
    char dummy;
    int carbs;
    int hydro;
    while (file >> name >> dummy >> carbs >> dummy >> hydro){
        insertMolecule(vec, name, carbs, hydro);
    }
}


int findFormula(vector<Formula>& vec, const int& carbs, const int& hydro) {
    for (int i = 0; i < vec.size(); ++i) {
        if (vec[i].carbs==carbs && vec[i].hydro==hydro) {
            return i;
        }
    }
    return vec.size();
}
void insertMolecule(vector<Formula>& vec, const string& name, const int& carbs, const int& hydro) {
    int ind = findFormula(vec, carbs, hydro);
    if (ind == vec.size()) {
        Formula newFormula;
        newFormula.carbs = carbs;
        newFormula.hydro = hydro;
        newFormula.names.push_back(name);
        vec.push_back(newFormula);
    }
    else {
        vec[ind].names.push_back(name);
    }
}

void displayVector(const vector<Formula>& vec) {
    for (int i = 0; i < vec.size(); ++i) {
        printFormula(vec[i]);
    }
}
void sortVector(vector<Formula>& vec) {
    int min_i;
    for (int i = 0; i < vec.size(); ++i) {
        min_i = i;
        for (int j = i + 1; j < vec.size(); ++j) {
            if (vec[j].carbs < vec[min_i].carbs ||
               (vec[j].carbs == vec[min_i].carbs && vec[j].hydro < vec[min_i].hydro)) {
                min_i = j;
               }
        }
        swap(vec[i], vec[min_i]);
    }
}

void printFormula(const Formula& f) {
    cout<<"C"<<f.carbs<<"H"<<f.hydro<<" "; //CxHx
    for (int j = 0; j < f.names.size(); ++j) {
        cout<<f.names[j]<<" ";
    }
    cout<<endl;
}

int main() {
    ifstream file;
    openFile(file);

    vector<Formula> vec;
    fillVector(vec, file);
    sortVector(vec);
    displayVector(vec);
    return 0;
}
